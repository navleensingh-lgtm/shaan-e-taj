# Database
# Local (no Docker): SQLite file
DATABASE_URL="file:../../packages/database/prisma/dev.db"
# Production / Docker Postgres:
# DATABASE_URL="postgresql://shaanetaj:shaanetaj_dev@localhost:5432/shaanetaj"

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=shaanetaj-products
R2_PUBLIC_URL=

# OpenAI
OPENAI_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=123456789

# WhatsApp (wa.me link — no API required for MVP)
NEXT_PUBLIC_WHATSAPP_NUMBER=919XXXXXXXXX

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Auth (NextAuth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-in-production

# Instagram / Meta (optional V1)
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# API
API_PORT=4000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
INTERNAL_API_SECRET=change-me-internal-secret

# Admin bootstrap (first login promotes to ADMIN)
ADMIN_EMAIL=admin@shaanetaj.com
ADMIN_PASSWORD=change-me-admin

# Image pipeline
WATERMARK_TEXT=Shaan-e-Taj
